# ---- Required -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Classic-car page, one post every 5 hours -------------------------------
NICHE=classic-cars
POST_INTERVAL_HOURS=5
# Protects the cron endpoint. Use the same value as the CRON_SECRET GitHub secret.
CRON_SECRET=

# ---- Optional (free) --------------------------------------------------------
# Real photos of classic cars. Free key: https://www.pexels.com/api/
PEXELS_API_KEY=
# Better captions. Either one is enough.
GROQ_API_KEY=
GEMINI_API_KEY=
